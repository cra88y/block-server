# database setup
DB_USER=secure_username
DB_PASS=password
DB_NAME=db_data
DB_PORT=26257

# nakama server keys
SOCKET_SERVER_KEY=password
RUNTIME_HTTP_KEY=password
SESSION_ENCRYPTION_KEY=a-32-byte-long-secret-encryption-key
SESSION_REFRESH_ENCRYPTION_KEY=a-32-byte-long-secret-encryption-key

# nakama console access
CONSOLE_USERNAME=secure_username
CONSOLE_PASSWORD=password
CONSOLE_SIGNING_KEY=password

# DEBUG, INFO, WARN, ERROR
NAKAMA_LOG_LEVEL=INFO

# apple iap
# StoreKit 2 JWS validation is PKI-based — no key needed, Nakama handles it natively.
# Shared secret only needed if supporting legacy StoreKit 1 clients (safe to leave blank for SK2-only apps).
# App Store Connect → Your App → In-App Purchases → App-Specific Shared Secret
IAP_APPLE_SHARED_SECRET=your_shared_secret_here
# App Store Connect → Your App → General → App Information → Notifications endpoint (optional)
IAP_APPLE_NOTIFICATIONS_ENDPOINT_ID=your_notifications_endpoint_id

# cloudflare r2 telemetry lakehouse
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
